# Base URL de la API
NEXT_PUBLIC_API_BASE_URL=http://tu-api.local.test/api/v1

# Timeout de requests en milisegundos (opcional, default: 10000)
NEXT_PUBLIC_API_TIMEOUT=10000

# Microsoft Clarity — analitica de comportamiento (grabaciones y mapas de calor).
# Se obtiene en https://clarity.microsoft.com al crear el proyecto del sitio.
# El ID por defecto ya esta en el codigo (no es un secreto: es publico en el
# HTML de cualquier sitio con Clarity). Esta variable solo sirve para
# sobrescribirlo por entorno, o dejarlo vacio para desactivar Clarity.
NEXT_PUBLIC_CLARITY_ID=
